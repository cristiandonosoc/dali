load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "lib",
    srcs = [
        "assets/asset.cpp",
        "assets/asset_editor.cpp",
        "assets/enemy_asset.cpp",
        "assets/registry.cpp",
        "assets/spritesheet_asset.cpp",
        "assets/texture_asset.cpp",
        "assets/tower_asset.cpp",
        "game.cpp",
        "graphics/gl.cpp",
        "graphics/texture.cpp",
        "hex.cpp",
        "platform.cpp",
        "scene.cpp",
        "serde.cpp",
        "ui/widgets.cpp",
    ],
    hdrs = [
        "assets/asset.h",
        "assets/asset_editor.h",
        "assets/enemy_asset.h",
        "assets/registry.h",
        "assets/spritesheet_asset.h",
        "assets/texture_asset.h",
        "assets/tower_asset.h",
        "game.h",
        "graphics/gl.h",
        "graphics/texture.h",
        "hex.h",
        "platform.h",
        "scene.h",
        "serde.h",
        "ui/widgets.h",
    ],
    visibility = ["//dali:__subpackages__"],
    deps = [
        "//dali/core",
        "//third_party:glad",
        "//third_party:imgui",
        "//third_party:stb",
        "//third_party:yaml-cpp",
    ],
)

cc_test(
    name = "hex_test",
    srcs = [
        "hex_test.cpp",
    ],
    testonly = True,
    size = "small",
    defines = ["KDK_IN_TEST=1"],
    deps = [
        ":lib",
        "//third_party:catch2",
    ],
)

cc_test(
    name = "serde_test",
    srcs = [
        "assets/asset_serde_test.cpp",
        "serde_test.cpp",
    ],
    testonly = True,
    size = "small",
    defines = ["KDK_IN_TEST=1"],
    deps = [
        ":lib",
        "//third_party:catch2",
    ],
)

# The hot-reloadable game DLL. linkshared makes this a shared library; the platform loads it by
# path at runtime (SDL_LoadObject), so nothing build-depends on it.
cc_binary(
    name = "game.dll",
    srcs = [
        "entrypoint.cpp",
    ],
    linkshared = True,
    visibility = ["//dali:__subpackages__"],
    deps = [
        ":lib",
        "//dali/core",
    ],
)
