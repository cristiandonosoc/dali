load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "lib",
    srcs = [
        "game.cpp",
        "hex.cpp",
        "log.cpp",
        "platform_state.cpp",
        "scene.cpp",
    ],
    hdrs = [
        "game.h",
        "hex.h",
        "log.h",
        "platform_state.h",
        "scene.h",
    ],
    visibility = ["//dali:__subpackages__"],
    deps = [
        "//dali/core",
        "//third_party:imgui",
        "//third_party:yaml-cpp",
    ],
)

cc_test(
    name = "hex_test",
    srcs = [
        "hex_test.cpp",
    ],
    testonly = True,
    size = "small",
    defines = ["KDK_IN_TEST=1"],
    deps = [
        ":lib",
        "//third_party:catch2",
    ],
)

# The hot-reloadable game DLL. linkshared makes this a shared library; the platform loads it by
# path at runtime (SDL_LoadObject), so nothing build-depends on it.
cc_binary(
    name = "game.dll",
    srcs = [
        "entrypoint.cpp",
    ],
    linkshared = True,
    visibility = ["//dali:__subpackages__"],
    deps = [
        ":lib",
        "//dali/core",
    ],
)
